{
    "name": "zzktz/laravel-kingbase",
    "description": "为 Laravel 8 及以上版本提供 KingbaseES 数据库连接驱动。",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "kingbase",
        "kingbasees",
        "database",
        "pdo_kdb"
    ],
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/database": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.23|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "phpunit/phpunit": "^9.3|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Zzktz\\LaravelKingbase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zzktz\\LaravelKingbase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zzktz\\LaravelKingbase\\KingbaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
